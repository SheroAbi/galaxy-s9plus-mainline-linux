[connection]
id=usb0-host
type=ethernet
interface-name=usb0
autoconnect=true
autoconnect-priority=100
autoconnect-retries=0

[ethernet]

[ipv4]
# DHCP if the PC shares its connection, plus a fixed address so the phone stays
# reachable at 172.16.42.2 even when nothing answers DHCP.
method=auto
may-fail=true
dhcp-timeout=15
address1=172.16.42.2/24

[ipv6]
method=ignore
