#!/bin/bash
# apt reaches the archives through the PC this phone is cabled to, but only
# while that proxy is actually there -- otherwise it must go straight out, e.g.
# once Wi-Fi is configured.
if timeout 1 bash -c 'exec 3<>/dev/tcp/172.16.42.1/8123' 2>/dev/null; then
	echo "http://172.16.42.1:8123"
else
	echo DIRECT
fi
