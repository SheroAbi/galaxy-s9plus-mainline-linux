[connection]
id=usb0-host
type=ethernet
interface-name=usb0
autoconnect=true
autoconnect-priority=100
autoconnect-retries=0

[ethernet]

[ipv4]
# Fixed address (manual). The PC side has a static 172.16.42.1 and runs no
# DHCP server, so method=auto (DHCP with the address as fallback) looped
# forever: ip-config-unavailable -> disconnect -> auto-activate every ~15 s,
# spamming "network error" notifications on the phone. PC and phone are a
# fixed pair, so manual is the correct mode.
method=manual
address1=172.16.42.2/24

[ipv6]
method=ignore
