#!/bin/sh
# Test-run helper for the S9+ mainline port. Runs from systemd on every boot:
# writes a status snapshot and the kernel log to /var/log/s9p every 15 s, and
# when the kernel command line carries s9p_testrun=N it reboots into TWRP
# (reboot argument "recovery" -> syscon-reboot-mode writes Samsung's recovery
# magic into INFORM3) once uptime reaches N seconds, so the host can read the
# logs back over ADB without anybody touching the phone.
D=/var/log/s9p
mkdir -p "$D"
N=$(sed -n 's/.*s9p_testrun=\([0-9]*\).*/\1/p' /proc/cmdline)
BOOT=$(date +%Y%m%dT%H%M%S)
: > "$D/status.log"
echo "s9p-testrun: boot $BOOT, testrun=${N:-off}, $(uname -r)" >> "$D/status.log"

snapshot() {
	echo "=== uptime $(cut -d' ' -f1 /proc/uptime) ==="
	for p in /sys/class/power_supply/*; do
		[ -e "$p" ] || continue
		echo "power ${p##*/}: type=$(cat $p/type 2>/dev/null) status=$(cat $p/status 2>/dev/null) online=$(cat $p/online 2>/dev/null) present=$(cat $p/present 2>/dev/null) cap=$(cat $p/capacity 2>/dev/null) V=$(cat $p/voltage_now 2>/dev/null) I=$(cat $p/current_now 2>/dev/null) T=$(cat $p/temp 2>/dev/null) health=$(cat $p/health 2>/dev/null)"
	done
	echo "input: $(cat /sys/class/input/input*/name 2>/dev/null | tr '\n' ',')"
	echo "udc: $(cat /sys/class/udc/*/state 2>/dev/null) $(cat /sys/class/udc/*/current_speed 2>/dev/null) function=$(cat /sys/class/udc/*/function 2>/dev/null)"
	echo "dri: $(ls /dev/dri 2>/dev/null | tr '\n' ' ')"
	echo "i2c: $(ls /sys/bus/i2c/devices 2>/dev/null | tr '\n' ' ')"
	echo "cpus online: $(cat /sys/devices/system/cpu/online)"
	echo "load: $(cat /proc/loadavg)"
	echo "mem: $(grep -E 'MemFree|MemAvailable' /proc/meminfo | tr '\n' ' ')"
	echo "gnome: $(pgrep -c gnome-shell 2>/dev/null) gdm: $(pgrep -c gdm 2>/dev/null) getty-ttyGS0: $(systemctl is-active serial-getty@ttyGS0.service 2>/dev/null)"
	echo "upower: $(upower -e 2>/dev/null | tr '\n' ' ')"
	# Reset-source hunt: cluster watchdogs (WTCON/WTDAT/WTCNT), the PMU
	# reset status, and the raw TMU temperatures of BIG/LITTLE and G3D/ISP.
	echo "wdt: $(/usr/local/sbin/s9p-mem 0x10050000 0x10050004 0x10050008 0x10060000 0x10060004 0x10060008 0x14060404 0x14060408 0x1406040c 2>/dev/null)"
	echo "tmu: $(/usr/local/sbin/s9p-mem 0x10070000 0x10070004 0x10070040 0x10070044 0x10070048 0x1007004c 0x10074000 0x10074040 0x10074044 2>/dev/null)"
}

while :; do
	snapshot >> "$D/status.log" 2>&1
	dmesg > "$D/dmesg.log" 2>&1
	journalctl -b --no-pager -o short-monotonic 2>/dev/null | tail -n 400 > "$D/journal.log"
	sync
	if [ -n "$N" ]; then
		UP=$(cut -d. -f1 /proc/uptime)
		if [ "$UP" -ge "$N" ]; then
			echo "s9p-testrun: uptime $UP >= $N, rebooting to TWRP" >> "$D/status.log"
			sync
			# INFORM3 already holds the recovery magic (clock-gates set list), so a
			# plain reboot lands in TWRP; the argument form only works on newer systemd.
			systemctl reboot --reboot-argument=recovery 2>/dev/null || systemctl reboot
			sleep 30
			echo b > /proc/sysrq-trigger
		fi
	fi
	sleep 15
done
