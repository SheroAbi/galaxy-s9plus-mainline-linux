CONFIG_POSITION_INDEPENDENT=y
CONFIG_EXYNOS_9810=y
CONFIG_SAMSUNG_STARLTE=y
CONFIG_TEXT_BASE=0x87000000
# starlte loads the payload at 0x90000000. On this S9+ that is not safe: a 22 MB
# kernel there spans 0x90000000-0x91550000, and sboot's own command line hands
# the following windows to the firmware side, all inside that span --
#   sec_avc_log=0x40000@0x91202000   sec_tsp_log=0x40000@0x91244000
#   sec_disp_log=0x100000@0x91286000 sec_summary_log=0x300000@0x91388000
#   sec_debug.base=0x100000@0x9168a000 auto_summary_log=0x10000@0x9178c000
# Anything still writing there after uniLoader has copied the kernel corrupts
# it in place, which shows up as the same image booting one time and hanging
# the next -- exactly the behaviour this port kept running into. 0x92000000
# clears the last of them (0x9179c000) with room to spare.
CONFIG_PAYLOAD_ENTRY=0x92000000
CONFIG_RAMDISK_ENTRY=0x84000000
CONFIG_FRAMEBUFFER_BASE=0xcc000000
CONFIG_FRAMEBUFFER_WIDTH=1440
CONFIG_FRAMEBUFFER_HEIGHT=2960
CONFIG_FRAMEBUFFER_STRIDE=4
